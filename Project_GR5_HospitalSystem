class StringUtils {
public:
    StringUtils() {}
    ~StringUtils() {}

    int getLength(string str) {
        int count = 0;
        while (str[count] != '\0') {
            count = count + 1;
        }
        return count;
    }

    int compareStrings(string s1, string s2) {
        int len1 = getLength(s1);
        int len2 = getLength(s2);
        if (len1 != len2) {
            return 0;
        }
        int i = 0;
        int match = 1;
        while (i < len1) {
            if (s1[i] != s2[i]) {
                match = 0;
            }
            i = i + 1;
        }
        return match;
    }
};

