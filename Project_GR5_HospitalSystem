class User
{
protected:
    string username;
    string password;
    string userType;
    int loginAttempts;
    int isLocked;
    
    Date registerDate;
    Time registerTime;

public:
    User()
    {
        username = "UnknownUser";
        password = "DefaultPassword123";
        userType = "None";
        loginAttempts = 0;
        isLocked = 0;
        
        registerDate.day = 1;
        registerDate.month = 1;
        registerDate.year = 2024;
        
        registerTime.hour = 0;
        registerTime.minute = 0;
        registerTime.second = 0;
    }

    virtual ~User()
    {
    }

    void setLoginInfo(string u)
    {
        username = u;
    }

    void setLoginInfo(string u, string p)
    {
        username = u;
        password = p;
    }

    string getUsername() { return username; }
    string getPassword() { return password; }
    void setUserType(string type) { userType = type; }
    string getUserType() { return userType; }

    // Pure virtual functions making this an Abstract Class
    virtual void displayRole() = 0;
    virtual void printDetailedProfile() = 0;
};


class Record
{
protected:
    int recordID;
    string recordStatus;
    Date creationDate;
    Time creationTime;
    int isArchived;

public:
    Record()
    {
        recordID = -1;
        recordStatus = "Pending Review";
        isArchived = 0;
        
        creationDate.day = 1;
        creationDate.month = 1;
        creationDate.year = 2024;
        
        creationTime.hour = 9;
        creationTime.minute = 0;
        creationTime.second = 0;
    }

    virtual ~Record()
    {
    }

    void setRecordID(int id) { recordID = id; }
    int getRecordID() { return recordID; }
    void setRecordStatus(string status) { recordStatus = status; }
    string getRecordStatus() { return recordStatus; }

    // Pure virtual functions
    virtual void printShortDetails() = 0;
    virtual void printFullSummary() = 0;
};


